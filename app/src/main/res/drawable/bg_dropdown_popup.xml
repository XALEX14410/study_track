<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded popup background for the materias ExposedDropdownMenu.
  Uses named color resources so Android picks the correct light/dark variant.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="12dp" />

    <solid android:color="@color/st_surface" />

    <stroke
        android:width="1dp"
        android:color="@color/st_outline" />

</shape>
